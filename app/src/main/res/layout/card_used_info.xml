<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/wifiname_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity=""
            android:padding="5.20dp"
            android:background="@color/wifacolor"
            android:orientation="vertical">
            <TextView
                android:id="@+id/vt_wifiname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_gravity="center"
                android:textColor="@color/colorWhite"
                android:text="بيانات الاستخدام"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/line_wifiname"
        android:layout_width="match_parent"
        android:layout_height="0.80dp"
        android:layout_marginTop="0.00dp"
        android:layout_marginBottom="15.00dp"
        android:background="@color/wifacolor"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:id="@+id/tx_1"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="10.00dp"
            android:textColor="@color/input_register_bg"
            android:text="يرجى الانتظار ..."/>
        <LinearLayout
            android:id="@+id/Linearlay_loading"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" >
            <pl.droidsonroids.gif.GifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/loading_blue"
                android:id="@+id/image_loading" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:id="@+id/loginform">
                <LinearLayout
                    android:id="@+id/lay_uptime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_uptime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="الوقت المستخدم:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_uptimelimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_uptimelimit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="الوقت المتبقي:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_download"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="التحميل المستخدم:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_transfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_transfer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="التحميل المتبقي:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_val"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="الصلاحية:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_lastseen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_lastseen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="اخر تسجيل دخول:"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay_cardsnum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.20dp"
                    android:layout_marginRight="10.20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_cardsadded"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/wifacolor2"
                        android:text="code"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="@color/input_register"
                        android:text="مرات الشحن:"/>

                </LinearLayout>
            </LinearLayout>


        <!-- Login Button -->

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="خــروج"
            android:textColor="@color/colorWhite"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="5.20dp"
            android:background="@color/colorAccent"/>

        <Button
            android:id="@+id/btn_session"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:text="عرض الجلسات"
            android:textColor="@color/colorWhite"
            android:layout_marginLeft="5.20dp"
            android:background="@color/wifacolor2"/>

    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">
        </LinearLayout>
    </LinearLayout>
</LinearLayout>