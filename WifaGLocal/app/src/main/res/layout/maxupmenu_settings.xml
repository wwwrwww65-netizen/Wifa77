<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="5dp">
    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/all_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Content here -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:gravity="right"
                    android:textSize="20.80dp"
                    android:textColor="@color/quizColor"
                    android:text="الإعدادات"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp"
                    android:text="المؤثرات الصوتية"
                    android:textStyle="bold"
                    android:drawablePadding="20dp"
                    android:drawableRight="@drawable/soundicon"
                    android:textColor="@color/colorPrimaryText"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:layout_height="wrap_content"/>

                <Switch
                    android:id="@+id/st_sounden"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_vertical"
                    android:layout_alignParentLeft="true"
                    android:layout_height="wrap_content" />

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp"
                    android:text="أصوات الخلفية"
                    android:drawablePadding="20dp"
                    android:drawableRight="@drawable/musicicon"
                    android:textColor="@color/colorPrimaryText"
                    android:textStyle="bold"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:layout_height="wrap_content"/>

                <Switch
                    android:id="@+id/st_musicen"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_vertical"
                    android:layout_alignParentLeft="true"
                    android:textColor="@color/colorAccent"
                    android:layout_height="wrap_content" />

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_margin="10dp"
                    android:textSize="16sp"
                    android:text="اللغة"
                    android:drawablePadding="20dp"
                    android:drawableRight="@drawable/langicon"
                    android:textColor="@color/colorPrimaryText"
                    android:textStyle="bold"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:layout_height="wrap_content"/>


                <Spinner
                    android:spinnerMode="dropdown"
                    android:layout_height="35dp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/spinner"
                    android:layout_gravity="center_vertical"
                    android:layout_alignParentLeft="true"
                    android:background="@drawable/custom_spinner_background"
                    android:layout_width="120dp"
                    />

            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.50dp"
                android:layout_marginRight="29.00dp"
                android:layout_marginLeft="29.00dp"
                android:layout_marginTop="15.00dp"
                android:layout_marginBottom="15.00dp"
                android:background="@color/wifacolor"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:gravity="right"
                    android:textSize="20.80dp"
                    android:textColor="@color/quizColor"
                    android:text="بياناتك الشخصية"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/st_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="16.80dp"
                        android:textColor="@color/quizColor"
                        android:text="name"/>

                    <TextView
                        android:id="@+id/bonus_point"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:drawablePadding="20dp"
                        android:drawableRight="@drawable/nameicon"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textSize="16.80dp"
                        android:textColor="@color/quizColor"
                        android:text="الاسم :"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/st_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="16.80dp"
                        android:textColor="@color/quizColor"
                        android:text="phone"/>

                    <TextView
                        android:id="@+id/bonus_point2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="1"
                        android:drawablePadding="20dp"
                        android:drawableRight="@drawable/phoneicon"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textSize="16.80dp"
                        android:textColor="@color/quizColor"
                        android:text="الموبايل :"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/st_editmyinfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="0.00dp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/wifacolor2"
                        android:text="تعديل" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_weight="2"
                        android:textStyle="bold"
                        android:textSize="16.80dp"
                        android:textColor="@color/quizColor"
                        android:text=""/>


                </LinearLayout>

            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.50dp"
                android:layout_marginRight="29.00dp"
                android:layout_marginLeft="29.00dp"
                android:layout_marginTop="15.00dp"
                android:layout_marginBottom="15.00dp"
                android:background="@color/wifacolor"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:gravity="right"
                    android:textSize="20.80dp"
                    android:textColor="@color/quizColor"
                    android:text="تطوير"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/st_wifacoimg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center"
                        android:layout_weight="1"
                        android:src="@drawable/wifalogo" />

                    <TextView
                        android:id="@+id/st_wifaco"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawablePadding="20dp"
                        android:drawableRight="@drawable/developericon"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textSize="16dp"
                        android:textColor="@color/wifacolor"
                        android:text="شركة وايفا للبرمجيات وخدمات الانترنت"/>

                </LinearLayout>

            </RelativeLayout>
            <LinearLayout
                android:id="@+id/st_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_weight="1"
                    android:drawablePadding="20dp"
                    android:drawableRight="@drawable/about"
                    android:textStyle="bold"
                    android:gravity="right"
                    android:textSize="18dp"
                    android:textColor="@color/wifacolor"
                    android:text="About"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0.50dp"
                android:layout_marginRight="29.00dp"
                android:layout_marginLeft="29.00dp"
                android:layout_marginTop="15.00dp"
                android:layout_marginBottom="15.00dp"
                android:background="@color/wifacolor"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:gravity="right"
                    android:textSize="16.80dp"
                    android:textColor="@color/quizColor"
                    android:text="الاصدار : 1.1.3"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
