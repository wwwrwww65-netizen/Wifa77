<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/bottom_layer22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="2dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/bottom_googleads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal">
            <com.google.android.gms.ads.AdView
                xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-5996028277858503/1319122620">
            </com.google.android.gms.ads.AdView>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/image_ads" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/Linearlay_Main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_layer22"
        android:overScrollMode="never"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/Linearlay_tx_home"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:background="@color/colorTextHint"
            android:orientation="horizontal"
            android:visibility="gone" >
            <TextView
                android:id="@+id/tx_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="17.00dp"
                android:textStyle="bold"
                android:textColor="@color/custom_progress_red_header"
                android:text="التطبيق لا يدعم الشبكة الحالية"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/Linearlay_loading"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:background="@color/colorTextHint"
            android:orientation="horizontal"
            android:visibility="gone" >
            <pl.droidsonroids.gif.GifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/loading_blue"
                android:visibility="gone"
                android:id="@+id/image_loading" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_main"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/all_lay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Content here -->
                <LinearLayout
                    android:id="@+id/wifiname_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="50dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="10dp"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity=""
                        android:padding="5.20dp"
                        android:background="@color/wifacolor2"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/vt_wifiname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_gravity="center"
                            android:textColor="@color/colorWhite"
                            android:text="اسم الشبكة"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:id="@+id/line_wifiname"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_marginTop="0.00dp"
                    android:layout_marginBottom="15.00dp"
                    android:background="@color/wifacolor2"/>
                <LinearLayout
                    android:id="@+id/winoffer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/vt_winoffer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text="إجمع وأربح"/>
                    <TextView
                        android:id="@+id/vt_winoffer_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text=""/>
                </LinearLayout>
                <View
                    android:id="@+id/line_win"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_marginTop="15.00dp"
                    android:layout_marginBottom="15.00dp"
                    android:background="@color/wifacolor2"/>
                <LinearLayout
                    android:id="@+id/offer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="50dp"
                    android:layout_marginLeft="50dp"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/vt_offer_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text="عرض جديد تعلن شبكة ماكس نت اللاسلكية عن عرض جديد في الكروت والذي يكون فيه"/>

                    <ImageView
                        android:id="@+id/offer_img"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"/>
                </LinearLayout>
                <View
                    android:id="@+id/line_offer"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_margin="28.40dp"
                    android:background="@color/wifacolor2"/>
                <ImageView
                    android:id="@+id/question_book"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingRight="29.20dp"
                    android:paddingLeft="29dp"
                    android:src="@drawable/questionbook2"
                    android:layout_gravity="center"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:paddingRight="29.20dp"
                    android:paddingLeft="29dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/act_gift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:textColor="@color/wifacolor"
                        android:text="اربح كرت عند الفوز في:"/>
                </LinearLayout>
                <View
                    android:id="@+id/line_contest"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_marginTop="15.00dp"
                    android:layout_marginBottom="15.00dp"
                    android:background="@color/wifacolor2"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>