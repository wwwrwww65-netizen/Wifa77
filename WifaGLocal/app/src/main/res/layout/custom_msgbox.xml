<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingLeft="13.60dp"
        android:paddingRight="13.60dp">
        <TextView
            android:id="@+id/textmsgbox"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="msg"
            android:textColor="@color/black"
            android:layout_marginTop="18.40dp"
            android:layout_marginBottom="0.80dp"
            android:textSize="20.60dp" />

        <EditText
            android:id="@+id/ddnameed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.40dp"
            android:background="@color/white"
            android:layout_alignParentRight="true"
            android:hint="الاسم : حقيقي او مستعار"
            android:inputType="text"
            android:padding="16.80dp"
            android:textColor="@color/input_register"
            android:textColorHint="@color/colorSecondaryText" />
        <EditText
            android:id="@+id/phoneeddd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19.20dp"
            android:background="@color/white"
            android:hint="phone"
            android:inputType="number"
            android:padding="16.80dp"
            android:textColor="@color/input_register"
            android:textColorHint="@color/colorSecondaryText" />


        <!-- Login Button -->

        <LinearLayout
            android:id="@+id/bottom_layer44"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19.20dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/msg_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="إلــغــاء"
                android:textColor="@color/colorWhite"
                android:layout_marginBottom="10.80dp"
                android:layout_marginRight="55.20dp"
                android:layout_marginLeft="55.20dp"
                android:background="@color/custom_progress_orange_progress"/>


        </LinearLayout>


    </LinearLayout>
</LinearLayout>