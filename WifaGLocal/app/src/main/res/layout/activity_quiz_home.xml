<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.wi_fa.wifag.QuizHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50.20dp"
        android:background="@color/wifacolor"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/quiz_question_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1/20"
                android:textSize="20.00dp"
                android:textStyle="bold"
                android:layout_marginLeft="38.40dp"
                android:gravity="center"
                android:textColor="@color/colorWhite"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/app_name"
                    android:layout_gravity="center"
                    android:src="@drawable/watch" />

                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="20"
                    android:layout_marginLeft="5.20dp"
                    android:textSize="22.50dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/colorWhite"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="right"
            android:layout_marginRight="10.40dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/quiz_station"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="المحطة : الاولى"
                android:textSize="16dp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorWhite"/>

        </LinearLayout>

    </LinearLayout>
    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0dp"
            android:layout_marginLeft="0dp"
            android:layout_alignParentTop="true"
            android:id="@+id/homeinfo_layer1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="200.00dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_gravity="center"
                android:gravity=""
                android:padding="5.20dp"
                android:background="@color/wifacolor2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quiz_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ديــــن"
                    android:layout_gravity="center"
                    android:textSize="22.70dp"
                    android:textColor="@color/colorWhite"/>



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160.00dp"
                android:orientation="vertical"
                android:padding="10.00dp"
                android:gravity="center"
                android:layout_marginLeft="18.40dp"
                android:layout_marginRight="18.40dp"
                android:background="@drawable/border">

                <TextView
                    android:id="@+id/quiz_questiony"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="من هو مؤلف كتاب في ظلال القران ؟"
                    android:layout_gravity="center"
                    android:textSize="20.00dp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:id="@+id/question_with_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.00dp"
                    android:src="@drawable/bookone"
                    android:layout_gravity="center"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="18.40dp"
                android:paddingRight="18.40dp"
                android:paddingTop="10.40dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/answer_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16.80dp"
                    android:textColor="@color/colorWhite"
                    android:text="Option 1"
                    android:textSize="16.00dp"
                    android:background="@color/custom_progress_orange_header"/>

                <Button
                    android:id="@+id/answer_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16.80dp"
                    android:textColor="@color/colorWhite"
                    android:layout_marginTop="7.20dp"
                    android:text="Option 2"
                    android:textSize="16.00dp"
                    android:background="@color/custom_progress_orange_header"/>

                <Button
                    android:id="@+id/answer_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16.80dp"
                    android:textColor="@color/colorWhite"
                    android:layout_marginTop="7.20dp"
                    android:text="Option 3"
                    android:textSize="16.00dp"
                    android:background="@color/custom_progress_orange_header"/>

                <Button
                    android:id="@+id/answer_four"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16.80dp"
                    android:textColor="@color/colorWhite"
                    android:layout_marginTop="7.20dp"
                    android:text="Option 4"
                    android:textSize="16.00dp"
                    android:background="@color/custom_progress_orange_header"/>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/help_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10.00dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingRight="20dp"
                    android:paddingLeft="20dp"
                    android:paddingBottom="20.20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/help_remove2op"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="حذف اجابتين"
                            android:textSize="16.00dp"
                            android:textColor="@color/colorWhite"
                            android:layout_marginRight="5dp"
                            android:background="@color/wifacolor"/>
                        <Button
                            android:id="@+id/help_changequiz"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16.00dp"
                            android:text="تغيير السؤال"
                            android:textColor="@color/colorWhite"
                            android:layout_marginLeft="5dp"
                            android:background="@color/wifacolor"/>
                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>