<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.wi_fa.wifag.QuizResultActivity">


    <LinearLayout
        android:id="@+id/bottom_layer22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/try_again"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مرة أخرى"
            android:textColor="@color/colorWhite"
            android:layout_marginRight="5.20dp"
            android:background="@color/colorAccent"/>

        <Button
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="خروج"
            android:textColor="@color/colorWhite"
            android:layout_marginLeft="5.20dp"
            android:background="@color/colorAccent"/>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_layer22"
        android:overScrollMode="never"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <ScrollView
            android:id="@+id/scroll_main"
            android:layout_width="fill_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/all_lay">
                <!-- Content here -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_above="@+id/bottom_layer"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rslt_status1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_gravity="center"
                        android:layout_marginTop="33.60dp"
                        android:textColor="@color/quizColor"
                        android:text="إنتهى الوقت"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginRight="38.40dp"
                        android:layout_marginLeft="38.40dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/wifacolor"/>

                    <TextView
                        android:id="@+id/rslt_status2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:paddingRight="10dp"
                        android:paddingLeft="10dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/quizColor"
                        android:text=""/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginLeft="38.40dp"
                        android:layout_marginRight="38.40dp"
                        android:paddingRight="10dp"
                        android:paddingLeft="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rslt_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:textColor="@color/quizColor"
                            android:text=""/>

                        <TextView
                            android:id="@+id/rslt_card2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:gravity="right"
                            android:textSize="20sp"
                            android:textColor="@color/quizColor"
                            android:text="رقم الكرت:"/>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/lay_card_pass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginLeft="38.40dp"
                        android:layout_marginRight="38.40dp"
                        android:paddingRight="19.20dp"
                        android:paddingLeft="19.20dp"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rslt_pass"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:textColor="@color/quizColor"
                            android:text="2568"/>

                        <TextView
                            android:id="@+id/rslt_pass2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:gravity="right"
                            android:textSize="20sp"
                            android:textColor="@color/quizColor"
                            android:text="كلمة المرور :"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/rslt_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_gravity="center"
                        android:layout_marginTop="30dp"
                        android:textColor="@color/quizColor"
                        android:text=""/>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginRight="38.40dp"
                        android:layout_marginLeft="38.40dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/wifacolor"/>
                    <LinearLayout
                        android:id="@+id/cardinfo_layer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentTop="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/card_qouta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_gravity="center"
                            android:textColor="@color/quizColor"
                            android:text="الرصيد"/>

                        <LinearLayout
                            android:id="@+id/lay_card_uptime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="38.40dp"
                            android:layout_marginRight="38.40dp"
                            android:paddingRight="10dp"
                            android:paddingLeft="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/card_uptime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text=""/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:gravity="right"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text="الوقت :"/>

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/lay_card_download"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="38.40dp"
                            android:layout_marginRight="38.40dp"
                            android:paddingRight="10dp"
                            android:paddingLeft="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/card_download"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text=""/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:gravity="right"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text="حجم التحميل :"/>

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/lay_card_val"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="38.40dp"
                            android:layout_marginRight="38.40dp"
                            android:paddingRight="10dp"
                            android:paddingLeft="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/card_val"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text=""/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                android:gravity="right"
                                android:textSize="16.80dp"
                                android:textColor="@color/quizColor"
                                android:text="الصلاحية :"/>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginRight="38.40dp"
                            android:layout_marginLeft="38.40dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="@color/wifacolor"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ads1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingRight="20dp"
                        android:paddingLeft="20dp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text="انتظرونا في تطبيق مجاني خاص بمسابقات ثقافية قيمة"/>
                    <TextView
                        android:id="@+id/ads2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingRight="20dp"
                        android:paddingLeft="20dp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text="من شركة وايفا للبرمجيات وخدمات الإنترنت"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Linearlay_loading"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="center"
        android:background="@color/colorTextHint"
        android:orientation="vertical"
        android:visibility="gone" >
        <pl.droidsonroids.gif.GifTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/loading_blue"
            android:visibility="gone"
            android:id="@+id/image_loading" />
    </LinearLayout>
    <com.google.android.gms.ads.AdView
        xmlns:ads="http://schemas.android.com/apk/res-auto"
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-5996028277858503/1319122620">
    </com.google.android.gms.ads.AdView>
</RelativeLayout>
