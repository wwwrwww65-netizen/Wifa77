<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.wi_fa.wifag.Notification_show">
    <android.support.design.widget.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:elevation="0dp">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar"/>
    </android.support.design.widget.AppBarLayout>
    <LinearLayout
        android:id="@+id/Linearlay_Main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/scroll_main"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/all_lay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Content here -->
                <LinearLayout
                    android:id="@+id/wifiname_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="50dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="10dp"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity=""
                        android:padding="5.20dp"
                        android:background="@color/wifacolor2"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/vt_wifiname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_gravity="center"
                            android:textColor="@color/colorWhite"
                            android:text="اسم الشبكة"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:id="@+id/line_wifiname"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_marginTop="0.00dp"
                    android:layout_marginBottom="15.00dp"
                    android:background="@color/wifacolor2"/>
                <LinearLayout
                    android:id="@+id/winoffer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15.00dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="100dp"
                                android:layout_marginTop="5dp"
                                android:layout_height="100dp"
                                android:layout_gravity="center"
                                android:id="@+id/circleView" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            android:padding="10.20dp">
                            <TextView
                                android:id="@+id/title_notf"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="right"
                                android:textSize="17.00dp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_marginTop="30dp"
                                android:text=""/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/notf_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_gravity="center"
                        android:textColor="@color/quizColor"
                        android:text=""/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:id="@+id/imgads" />
                </LinearLayout>
                <View
                    android:id="@+id/line_win"
                    android:layout_width="match_parent"
                    android:layout_height="0.80dp"
                    android:layout_marginRight="29.00dp"
                    android:layout_marginLeft="29.00dp"
                    android:layout_marginTop="15.00dp"
                    android:layout_marginBottom="15.00dp"
                    android:background="@color/wifacolor2"/>
                <Button
                    android:id="@+id/btn_ok"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:textSize="20sp"
                    android:text="Exit"
                    android:textColor="@color/colorWhite"
                    android:background="@color/colorAccent"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>