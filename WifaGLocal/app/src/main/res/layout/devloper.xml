<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/AppThemeFullScreen">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:paddingRight="0.20dp"
            android:paddingLeft="19dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="20.80dp"
                android:textColor="@color/quizColor"
                android:text="تطوير :"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:paddingRight="10.20dp"
            android:paddingLeft="0dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_alignParentRight="true"
                android:elevation="12.20dp"
                android:layout_weight="1"
                android:src="@drawable/wifalogo" />

            <TextView
                android:id="@+id/st_wifaco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="0dp"
                android:layout_weight="3"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="17dp"
                android:textColor="@color/wifacolor"
                android:text="شركة وايفا للبرمجيات وخدمات الانترنت | اليمن - صنعاء"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center"
            android:paddingRight="0.20dp"
            android:paddingLeft="19dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="16dp"
                android:textColor="@color/quizColor"
                android:text="www.wi-fa.com"/>


        </LinearLayout>

    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.50dp"
        android:layout_marginRight="29.00dp"
        android:layout_marginLeft="29.00dp"
        android:layout_marginTop="15.00dp"
        android:layout_marginBottom="15.00dp"
        android:background="@color/wifacolor"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:paddingRight="10.00dp"
            android:paddingLeft="0dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_alignParentRight="true"
                android:elevation="12.20dp"
                android:layout_weight="1"
                android:src="@drawable/profile2" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="0dp"
                android:layout_weight="3"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="17dp"
                android:textColor="@color/quizColor"
                android:text="م/ أحمد محمد العليمي"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center"
            android:paddingRight="0.20dp"
            android:paddingLeft="19dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="16dp"
                android:textColor="@color/quizColor"
                android:text="it@wi-fa.com"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.50dp"
        android:layout_marginRight="29.00dp"
        android:layout_marginLeft="29.00dp"
        android:layout_marginTop="15.00dp"
        android:layout_marginBottom="15.00dp"
        android:background="@color/wifacolor"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:paddingRight="10.00dp"
            android:paddingLeft="0dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center"
                android:layout_alignParentRight="true"
                android:elevation="12.20dp"
                android:layout_weight="1"
                android:src="@drawable/admin3" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="0dp"
                android:layout_weight="3"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="17dp"
                android:textColor="@color/quizColor"
                android:text="م/ علي عبدالله البدوي"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center"
            android:paddingRight="0.20dp"
            android:paddingLeft="19dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="16dp"
                android:textColor="@color/quizColor"
                android:text="ceo@wi-fa.com"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16.80dp"
                android:textColor="@color/quizColor"
                android:text=""/>

            <Button
                android:id="@+id/dv_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:backgroundTint="@color/wifacolor2"
                android:elevation="4.50dp"
                android:text="ok"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16.80dp"
                android:textColor="@color/quizColor"
                android:text=""/>


        </LinearLayout>
    </RelativeLayout>
</LinearLayout>