<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/bottom_layer22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="2dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/bottom_layer01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/act_sellers2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="نقاط البيع"
                android:textSize="22sp"
                android:textColor="@color/colorWhite"
                android:layout_marginRight="5.20dp"
                android:background="@color/wifacolor2"/>
            <Button
                android:id="@+id/act_cards2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="أسعار الكروت"
                android:textSize="22sp"
                android:textColor="@color/colorWhite"
                android:layout_marginLeft="5.20dp"
                android:background="@color/wifacolor2"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/image_ads" />
        <LinearLayout
            android:id="@+id/bottom_googleads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:visibility="gone"
            android:orientation="horizontal">
            <com.google.android.gms.ads.AdView
                xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-5996028277858503/1319122620">
            </com.google.android.gms.ads.AdView>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/all_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_layer22"
        android:overScrollMode="never"
        android:layout_marginBottom="5dp">
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                android:orientation="vertical"
                android:id="@+id/all_lay">
                <!-- Content here -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/linearlayout_top">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_width="100dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_height="100dp"
                                    android:layout_gravity="center"
                                    android:id="@+id/circleView" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:orientation="vertical"
                                android:padding="10.20dp">

                                <TextView
                                    android:id="@+id/title_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:textSize="17.00dp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:layout_marginTop="2.20dp"
                                    android:text=""/>

                                <TextView
                                    android:id="@+id/title_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:layout_marginTop="2dp"
                                    android:textSize="16.00dp"
                                    android:text="خدمة العملاء"/>

                                <TextView
                                    android:id="@+id/title_phone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:textSize="16.80dp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/input_login_hint"
                                    android:text=""/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/wifacolor2"
                        android:id="@+id/viewline1"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:id="@+id/lay2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10.20dp"
                                android:layout_marginRight="10.20dp"
                                android:layout_marginBottom="10dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/contxtstat"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_weight="1"
                                    android:textStyle="bold"
                                    android:textSize="16.80dp"
                                    android:textColor="@color/quizColor"
                                    android:text="غير متصل"/>

                                <TextView
                                    android:id="@+id/statcontxt"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_weight="1"
                                    android:textStyle="bold"
                                    android:gravity="right"
                                    android:textSize="16.80dp"
                                    android:textColor="@color/quizColor"
                                    android:text="حالة الإتصال:"/>

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/Linearlay_loading2"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:visibility="gone" >
                                <pl.droidsonroids.gif.GifTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/loading_blue"
                                    android:visibility="gone"
                                    android:id="@+id/image_loading2" />
                            </LinearLayout>
                            <FrameLayout
                                android:id="@+id/statusconn"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:paddingLeft="13.60dp"
                                    android:paddingRight="13.60dp">
                                    <Button
                                        android:id="@+id/statinfo_btn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="بـيـانـات الإسـتـخـدام"
                                        android:visibility="gone"
                                        android:textSize="14dp"
                                        android:textColor="@color/colorWhite"
                                        android:layout_marginTop="40dp"
                                        android:background="@color/wifacolor"/>
                                    <EditText
                                        android:id="@+id/ed_loginuser"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:background="@drawable/custom_spinner_background"
                                        android:layout_alignParentRight="true"
                                        android:hint="اسم المستخدم"
                                        android:inputType="text"
                                        android:padding="13dp"
                                        android:textColor="@color/input_register"
                                        android:textColorHint="@color/colorSecondaryText" />
                                    <EditText
                                        android:id="@+id/ed_loginpass"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:hint="كلمة المرور"
                                        android:background="@drawable/custom_spinner_background"
                                        android:inputType="text"
                                        android:padding="13dp"
                                        android:textColor="@color/input_register"
                                        android:textColorHint="@color/colorSecondaryText" />
                                    <RelativeLayout
                                        android:id="@+id/Cookielay"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:layout_marginTop="10dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:textSize="14sp"
                                            android:text="تسجيل دخول تلقائي عند الإتصال بالشبكة"
                                            android:textStyle="bold"
                                            android:textColor="@color/quizColor"
                                            android:layout_alignParentRight="true"
                                            android:layout_gravity="center_vertical"
                                            android:layout_height="wrap_content"/>

                                        <Switch
                                            android:id="@+id/Cookiecheckbox"
                                            android:layout_width="wrap_content"
                                            android:layout_marginTop="10dp"
                                            android:layout_gravity="center"
                                            android:layout_alignParentLeft="true"
                                            android:layout_height="wrap_content" />

                                    </RelativeLayout>
                                    <Button
                                        android:id="@+id/loginbtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="تسجيل الدخـــــــول"
                                        android:textColor="@color/colorWhite"
                                        android:background="@color/colorIcons"/>
                                    <!-- Login Button -->

                                </LinearLayout>

                            </FrameLayout>

                        </LinearLayout>

                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.50dp"
                        android:layout_marginRight="29.00dp"
                        android:layout_marginLeft="29.00dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="0dp"
                        android:background="@color/wifacolor2"/>
                    <LinearLayout
                        android:id="@+id/bottom_layer00"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="10dp"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/act_sellers"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="نقاط البيع"
                            android:textSize="22sp"
                            android:textColor="@color/colorWhite"
                            android:layout_marginRight="5.20dp"
                            android:background="@color/wifacolor2"/>
                        <Button
                            android:id="@+id/act_cards"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="أسعار الكروت"
                            android:textSize="22sp"
                            android:textColor="@color/colorWhite"
                            android:layout_marginLeft="5.20dp"
                            android:background="@color/wifacolor2"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/linear_tx_home"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:background="@color/colorTextHint"
            android:orientation="horizontal"
            android:visibility="gone" >
            <TextView
                android:id="@+id/tx_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17.00dp"
                android:textStyle="bold"
                android:textColor="@color/custom_progress_red_header"
                android:text="لا يوجد إتصال بالشبكة"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/Linearlay_loading1"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:background="@color/colorTextHint"
            android:orientation="horizontal"
            android:visibility="gone" >
            <pl.droidsonroids.gif.GifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/loading_blue"
                android:id="@+id/image_loading1" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
